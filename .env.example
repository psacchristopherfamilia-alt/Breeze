# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=    # clave pública (anon / publishable)
# Sin estas dos variables la app arranca en MODO PROTOTIPO (datos falsos, sin login).
SUPABASE_SERVICE_ROLE_KEY=        # solo servidor / Edge Functions

# App
NEXT_PUBLIC_APP_NAME=Breeze
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Grand_Turk
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Notificaciones
#   console → los mensajes se imprimen en el log (desarrollo)
#   live    → Resend (correo) y Twilio (SMS / WhatsApp), solo los que tengan claves abajo
NOTIFICATIONS_PROVIDER=console
# Secreto que debe enviar el cron al worker: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM="Breeze <hello@example.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Antiabuso para reservas de invitados (Cloudflare Turnstile, gratis: dash.cloudflare.com → Turnstile → Add widget).
# Sin las dos claves el captcha queda DESACTIVADO. Con ellas, el invitado debe pasarlo para reservar.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Avisos en el teléfono (Web Push). Genera el par de claves con:  npx web-push generate-vapid-keys
# La pública va al navegador; la privada SOLO en el servidor (variable sensible en Vercel).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del remitente (https://tu-dominio o mailto:tu@correo). Opcional: por defecto, la dirección de la app.
VAPID_SUBJECT=
